            "state": "translated",
            "value": "Transform the selected text"
          }
        }
      }
    },
    "Tutto resta in riproduzione, ma più piano: il volume torna com'era quando hai finito.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything keeps playing, but quieter: the volume goes back to what it was when you are done."
          }
