    "titolo, data, durata, partecipanti e appunti della riunione": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "title, date, duration, participants and notes of the meeting"
          }
        }
      }
    },
    "«%@» e il suo audio vengono spostati nel Cestino.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” and its audio will be moved to the Trash."
          }
        }
      }
    },
    "«%@» → «%@»": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” → “%@”"
          }
        }
      }
    },
    "«Suggerisci nomi»: cerca nella trascrizione i nomi dei parlanti. Deve restare una risposta in JSON come {\"s1\": \"Marco\", \"s2\": null}, altrimenti Voce non sa leggerla.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Suggest names”: looks for the speakers’ names in the transcript. It must stay a JSON answer like {\"s1\": \"Marco\", \"s2\": null}, otherwise Voce cannot read it."
          }
        }
      }
    },
    "«Traduci in inglese», «rendilo più formale»…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Translate into Italian”, “make it more formal”…"
          }
        }
      }
    },
    "È già nel dizionario.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's already in the dictionary."
          }
        }
      }
