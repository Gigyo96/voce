    },
    "Un servizio dedicato": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dedicated service"
          }
        }
      }
    },
    "Una sola chiave per centinaia di modelli di provider diversi, a consumo.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One key for hundreds of models from different providers, pay as you go."
          }
        }
