    "Silenzia": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute"
          }
        }
      }
    },
    "Silenzia: la traccia resta ma senza audio": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute: the track stays but silent"
          }
        }
      }
