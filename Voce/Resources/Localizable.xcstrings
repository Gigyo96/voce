            "state": "translated",
            "value": "Invalid LLM URL"
          }
        }
      }
    },
    "Ultima: “%@”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last: “%@”"
          }
        }
      }
    },
    "Ultra è più preciso, stessa velocità. Cambiandolo si scaricano ~700 MB.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ultra is more accurate at the same speed. Switching downloads ~700 MB."
          }
        }
