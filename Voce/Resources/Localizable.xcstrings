            "value": "Service"
          }
        }
      }
    },
    "Servizio non raggiungibile: controlla l'indirizzo e la connessione a internet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Service unreachable: check the address and your internet connection."
